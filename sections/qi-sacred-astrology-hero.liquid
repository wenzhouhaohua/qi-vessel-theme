{{ 'qi-sacred-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'qi-sacred-hero.js' | asset_url }}" defer></script>

<section id="QiVisualLock-{{ section.id }}" class="qi-lock" data-qi-visual-lock data-api-endpoint="{{ section.settings.api_endpoint | escape }}">
  <picture class="qi-lock__art" aria-hidden="true">
    <source media="(max-width: 749px)" srcset="{{ 'qi-vessel-final-mobile-lock.webp' | asset_url }}">
    <img
      src="{{ 'qi-vessel-final-visual-lock.png' | asset_url }}"
      width="1197"
      height="1314"
      alt=""
      loading="eager"
      fetchpriority="high"
    >
  </picture>

  <div class="qi-lock__interactive">
    <a class="qi-lock__hotspot qi-lock__hotspot--home" href="{{ routes.root_url }}" aria-label="Home"></a>
    <a class="qi-lock__hotspot qi-lock__hotspot--about" href="{{ routes.root_url }}pages/about" aria-label="About"></a>
    <a class="qi-lock__hotspot qi-lock__hotspot--how" href="#QiJourney-{{ section.id }}" aria-label="How it works"></a>
    <a class="qi-lock__hotspot qi-lock__hotspot--crystals" href="{{ routes.collections_url }}" aria-label="Crystals"></a>
    <a class="qi-lock__hotspot qi-lock__hotspot--journal" href="{{ routes.blogs_url }}" aria-label="Journal"></a>
    <a class="qi-lock__hotspot qi-lock__hotspot--signin" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="Sign in"></a>

    <button class="qi-lock__hotspot qi-lock__hotspot--begin" type="button" data-open-reading aria-label="Begin your reading"></button>

    <form class="qi-lock__form" data-astral-form novalidate>
      <label class="visually-hidden" for="QiName-{{ section.id }}">Name</label>
      <input id="QiName-{{ section.id }}" class="qi-lock__control qi-lock__control--name" name="name" autocomplete="name" required>

      <label class="visually-hidden" for="QiDate-{{ section.id }}">Birth date</label>
      <input id="QiDate-{{ section.id }}" class="qi-lock__control qi-lock__control--date" name="birth_date" type="date" required>

      <label class="visually-hidden" for="QiPlace-{{ section.id }}">Birth place</label>
      <input id="QiPlace-{{ section.id }}" class="qi-lock__control qi-lock__control--place" name="birth_place" autocomplete="address-level2" required>

      <fieldset class="qi-lock__intentions">
        <legend class="visually-hidden">What are you seeking clarity on?</legend>
        <label><input type="radio" name="intention" value="Emotional Balance" required><span class="visually-hidden">Emotional Balance</span></label>
        <label><input type="radio" name="intention" value="Purpose & Growth"><span class="visually-hidden">Purpose and Growth</span></label>
        <label><input type="radio" name="intention" value="Love & Connection"><span class="visually-hidden">Love and Connection</span></label>
      </fieldset>

      <button class="qi-lock__submit" type="submit" aria-label="Reveal my energy map"></button>
      <p class="visually-hidden" role="status" aria-live="polite" data-form-status></p>
    </form>
  </div>

  <span id="QiJourney-{{ section.id }}" class="qi-lock__journey-anchor" aria-hidden="true"></span>

  <dialog class="qi-lock__ritual" data-ritual-dialog>
    <button class="qi-lock__ritual-close" type="button" aria-label="Close" data-close-ritual>×</button>
    <div class="qi-lock__ritual-wheel" aria-hidden="true">✦</div>
    <p data-ritual-stage>ALIGNING YOUR CELESTIAL PATTERNS…</p>
  </dialog>
</section>

{% schema %}
{
  "name": "QI Final Visual Lock",
  "tag": "section",
  "class": "section-qi-final-visual-lock",
  "settings": [
    {"type":"text","id":"api_endpoint","label":"Secure reading API endpoint","info":"Optional. Leave blank until your secure server endpoint is ready."}
  ],
  "presets": [{"name":"QI Final Visual Lock"}]
}
{% endschema %}
