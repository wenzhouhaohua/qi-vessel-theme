{{ 'qi-sacred-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'qi-sacred-hero.js' | asset_url }}" defer></script>

<section
  id="QiSacredHero-{{ section.id }}"
  class="qi-sacred"
  data-qi-sacred
  data-api-endpoint="{{ section.settings.api_endpoint | escape }}"
>
  <div class="qi-sacred__cosmos" aria-hidden="true">
    <span class="qi-sacred__nebula qi-sacred__nebula--one"></span>
    <span class="qi-sacred__nebula qi-sacred__nebula--two"></span>
    <span class="qi-sacred__stars qi-sacred__stars--far"></span>
    <span class="qi-sacred__stars qi-sacred__stars--near"></span>
    <span class="qi-sacred__light-column"></span>
  </div>

  <header class="qi-sacred__nav">
    <a class="qi-sacred__brand" href="{{ routes.root_url }}" aria-label="QI Vessel home">
      <span class="qi-sacred__brand-mark" aria-hidden="true">
        <svg viewBox="0 0 64 64" role="presentation">
          <circle cx="32" cy="32" r="27"></circle><circle cx="32" cy="32" r="20"></circle>
          <path d="M32 7v50M7 32h50M14.3 14.3l35.4 35.4M49.7 14.3 14.3 49.7"></path>
          <path class="fill" d="m32 18 3.7 10.3L46 32l-10.3 3.7L32 46l-3.7-10.3L18 32l10.3-3.7L32 18Z"></path>
        </svg>
      </span>
      <span class="qi-sacred__brand-copy"><strong>QI VESSEL</strong><small>SACRED ASTROLOGY</small></span>
    </a>

    <button class="qi-sacred__menu-toggle" type="button" aria-expanded="false" aria-controls="QiSacredMenu-{{ section.id }}" data-menu-toggle>
      <span></span><span></span><span></span><span class="visually-hidden">Menu</span>
    </button>

    <nav id="QiSacredMenu-{{ section.id }}" class="qi-sacred__links" aria-label="Main navigation" data-menu>
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
      {% else %}
        <a href="#QiSacredHero-{{ section.id }}">Home</a>
        <a href="{{ routes.root_url }}pages/about">About</a>
        <a href="#QiJourney-{{ section.id }}">How it works</a>
        <a href="{{ routes.collections_url }}">Crystals</a>
        <a href="{{ routes.blogs_url }}">Journal</a>
      {% endif %}
    </nav>

    <div class="qi-sacred__actions">
      <a class="qi-sacred__account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
        {% if customer %}ACCOUNT{% else %}SIGN IN{% endif %} <span>＋</span>
      </a>
      <a class="qi-sacred__cart" href="{{ routes.cart_url }}" aria-label="Cart">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8h12l1 12H5L6 8Zm3 0V6a3 3 0 0 1 6 0v2"></path></svg>
      </a>
    </div>
  </header>

  <div class="qi-sacred__stage">
    <div class="qi-sacred__copy">
      <p class="qi-sacred__eyebrow"><span>✦</span>{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <div class="qi-sacred__intro">{{ section.settings.text }}</div>
      <button class="qi-sacred__primary" type="button" data-open-reading>{{ section.settings.cta }} <span>＋</span></button>
      <div class="qi-sacred__requirements" aria-label="Birth information required">
        <span><i>☉</i>Birth Date</span><span><i>☾</i>Birth Time</span><span><i>⌖</i>Birth Place</span>
      </div>
      <p class="qi-sacred__micro">Personal Reflection&nbsp;&nbsp;•&nbsp;&nbsp;Crystal Recommendation</p>
    </div>

    <div class="qi-sacred__oracle" aria-label="Sacred astrology guide">
      <div class="qi-sacred__beam" aria-hidden="true"></div>
      {% if section.settings.priestess != blank %}
        {{ section.settings.priestess | image_url: width: 1600 | image_tag: class: 'qi-sacred__priestess qi-sacred__priestess--custom', loading: 'eager', fetchpriority: 'high', widths: '480,720,960,1200,1600', sizes: '(max-width: 899px) 100vw, 44vw', alt: 'Sacred astrology guide' }}
      {% else %}
        <img class="qi-sacred__priestess qi-sacred__priestess--reconstruction" src="{{ 'qi-oracle-master.png' | asset_url }}" alt="Celestial oracle in a sacred astrology ritual" width="860" height="850" loading="eager" fetchpriority="high">
      {% endif %}
      <span class="qi-sacred__oracle-vignette" aria-hidden="true"></span>
    </div>

    <aside class="qi-sacred__record" id="QiRecord-{{ section.id }}" data-reading-panel>
      <div class="qi-sacred__record-cap" aria-hidden="true"><span>✦</span></div>
      <h2>{{ section.settings.form_heading }}</h2>
      <p>{{ section.settings.form_text }}</p>
      <div class="qi-sacred__ornament" aria-hidden="true"><span></span>✦<span></span></div>

      <form class="qi-sacred__form" data-astral-form novalidate>
        <label class="qi-sacred__field">
          <span><b>01</b> YOUR NAME</span>
          <span class="qi-sacred__input"><input name="name" type="text" autocomplete="name" enterkeyhint="next" placeholder="Enter your full name" required><i>♙</i></span>
        </label>
        <label class="qi-sacred__field">
          <span><b>02</b> DATE OF BIRTH</span>
          <span class="qi-sacred__input"><input name="birth_date" type="date" autocomplete="bday" required><i>▣</i></span>
        </label>
        <label class="qi-sacred__field">
          <span><b>03</b> TIME OF BIRTH</span>
          <span class="qi-sacred__input"><input name="birth_time" type="time" autocomplete="off" required><i>◷</i></span>
        </label>
        <label class="qi-sacred__field">
          <span><b>04</b> PLACE OF BIRTH</span>
          <span class="qi-sacred__input"><input name="birth_place" type="text" autocomplete="address-level2" enterkeyhint="next" placeholder="City, State / Province, Country" required><i>⌖</i></span>
        </label>
        <label class="qi-sacred__field">
          <span><b>05</b> EMAIL ADDRESS</span>
          <span class="qi-sacred__input"><input name="email" type="email" inputmode="email" autocomplete="email" enterkeyhint="done" placeholder="you@example.com" required><i>✉</i></span>
        </label>
        <button class="qi-sacred__submit" type="submit">{{ section.settings.submit_text }} <span>＋</span></button>
        <p class="qi-sacred__privacy">♙ &nbsp;Your birth information is encrypted and protected.<br>Your personalized reading will be sent to this email.</p>
        <p class="qi-sacred__status" role="status" aria-live="polite" data-form-status></p>
      </form>
    </aside>
  </div>

  <div id="QiJourney-{{ section.id }}" class="qi-sacred__journey">
    <p>ANCIENT WISDOM. PERSONALIZED FOR YOU.</p>
    <h2>A Journey Into Your True Essence</h2>
    <div class="qi-sacred__journey-rule" aria-hidden="true"><span></span>✦<span></span></div>
    <div class="qi-sacred__pillars">
      <article><i>☉</i><h3>PERSONAL REFLECTION</h3><p>Thoughtful interpretation of your birth chart patterns.</p></article>
      <article><i>◉</i><h3>ENERGY INSIGHTS</h3><p>Understand your strengths, challenges and hidden gifts.</p></article>
      <article><i>♢</i><h3>CRYSTAL ALIGNMENT</h3><p>Discover the crystal that symbolically resonates with your energy.</p></article>
      <article><i>◯</i><h3>PERSONAL BRACELET</h3><p>Wear your intention and stay connected to your chosen path.</p></article>
    </div>
  </div>

  <dialog class="qi-sacred__ritual" data-ritual-dialog>
    <button class="qi-sacred__ritual-close" type="button" aria-label="Close" data-close-ritual>×</button>
    <div class="qi-sacred__ritual-wheel" aria-hidden="true">✦</div>
    <p data-ritual-stage>ALIGNING YOUR CELESTIAL PATTERNS…</p>
  </dialog>
</section>

{% schema %}
{
  "name": "QI Sacred Hero",
  "tag": "section",
  "class": "section-qi-sacred-hero",
  "settings": [
    {"type":"image_picker","id":"priestess","label":"Priestess image"},
    {"type":"link_list","id":"menu","label":"Navigation menu"},
    {"type":"text","id":"api_endpoint","label":"Secure reading API endpoint","info":"Optional. Leave blank until your secure server endpoint is ready."},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"A PERSONAL ASTROLOGICAL JOURNEY"},
    {"type":"inline_richtext","id":"heading","label":"Heading","default":"Reveal The Story Written In Your Stars"},
    {"type":"richtext","id":"text","label":"Introduction","default":"<p>Your birth chart holds the keys to your personality, purpose and inner energy. Discover your personalized crystal connection and guidance.</p>"},
    {"type":"text","id":"cta","label":"Primary button","default":"BEGIN YOUR READING"},
    {"type":"text","id":"form_heading","label":"Form heading","default":"YOUR ASTRAL PROFILE"},
    {"type":"textarea","id":"form_text","label":"Form introduction","default":"Enter your exact birth details to begin your personalized astrology reading."},
    {"type":"text","id":"submit_text","label":"Submit button","default":"REVEAL MY DESTINY"}
  ],
  "presets": [{"name":"QI Sacred Hero"}]
}
{% endschema %}
