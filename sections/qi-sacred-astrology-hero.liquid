{{ 'qi-sacred-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'qi-sacred-hero.js' | asset_url }}" defer></script>

<section id="QiSacredHero-{{ section.id }}" class="qi-sacred" data-qi-sacred data-api-endpoint="{{ section.settings.api_endpoint | escape }}">
  <div class="qi-sacred__cosmos" aria-hidden="true">
    <span class="qi-sacred__nebula qi-sacred__nebula--one"></span>
    <span class="qi-sacred__nebula qi-sacred__nebula--two"></span>
    <span class="qi-sacred__stars"></span>
    <span class="qi-sacred__light-column"></span>
  </div>

  <header class="qi-sacred__nav page-width">
    <a class="qi-sacred__brand" href="{{ routes.root_url }}" aria-label="QI Vessel home">
      <span class="qi-sacred__brand-mark" aria-hidden="true">✦</span>
      <span><strong>QI VESSEL</strong><small>SACRED ASTROLOGY</small></span>
    </a>
    {% if section.settings.menu != blank %}
      <nav class="qi-sacred__links" aria-label="Main navigation">
        {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
      </nav>
    {% endif %}
    <a class="qi-sacred__account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">SIGN IN <span>＋</span></a>
  </header>

  <div class="qi-sacred__layout page-width">
    <div class="qi-sacred__copy">
      <p class="qi-sacred__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <div class="qi-sacred__intro">{{ section.settings.text }}</div>
      <button class="qi-sacred__primary" type="button" data-open-reading>{{ section.settings.cta }} <span>＋</span></button>
      <div class="qi-sacred__requirements" aria-label="Birth information required">
        <span><i>☉</i> Birth Date</span><span><i>☾</i> Birth Time</span><span><i>⌖</i> Birth Place</span>
      </div>
      <p class="qi-sacred__micro">Personal Reflection&nbsp;&nbsp;•&nbsp;&nbsp;Crystal Recommendation</p>
    </div>

    <div class="qi-sacred__oracle" aria-label="Sacred astrology guide">
      <div class="qi-sacred__beam" aria-hidden="true"></div>
      <svg class="qi-sacred__wheel" viewBox="0 0 600 600" aria-hidden="true">
        <defs>
          <filter id="qiGlow{{ section.id }}"><feGaussianBlur stdDeviation="2" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        </defs>
        <g filter="url(#qiGlow{{ section.id }})">
          <circle cx="300" cy="300" r="250"/><circle cx="300" cy="300" r="214"/><circle cx="300" cy="300" r="172"/><circle cx="300" cy="300" r="112"/>
          {% for i in (0..11) %}<line x1="300" y1="50" x2="300" y2="94" transform="rotate({{ i | times: 30 }} 300 300)"/>{% endfor %}
          {% for i in (0..23) %}<line x1="300" y1="50" x2="300" y2="64" transform="rotate({{ i | times: 15 }} 300 300)"/>{% endfor %}
          <path d="M300 100 L322 268 L500 300 L322 332 L300 500 L278 332 L100 300 L278 268 Z"/>
        </g>
      </svg>
      <div class="qi-sacred__halo" aria-hidden="true"></div>
      {% if section.settings.priestess != blank %}
        {{ section.settings.priestess | image_url: width: 1200 | image_tag: class: 'qi-sacred__priestess', loading: 'eager', fetchpriority: 'high', widths: '480,720,960,1200', sizes: '(max-width: 749px) 100vw, 42vw', alt: 'Sacred astrology guide' }}
      {% else %}
        <img class="qi-sacred__priestess" src="{{ 'qi-priestess.png' | asset_url }}" alt="Sacred astrology guide" width="900" height="1600" loading="eager" fetchpriority="high">
      {% endif %}
      <div class="qi-sacred__crystal" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
    </div>

    <div class="qi-sacred__record" id="QiRecord-{{ section.id }}" data-reading-panel>
      <div class="qi-sacred__record-symbol">✦</div>
      <h2>{{ section.settings.form_heading }}</h2>
      <p>{{ section.settings.form_text }}</p>
      <form class="qi-sacred__form" data-astral-form novalidate>
        <label><b>01</b><span>WHAT SHOULD WE CALL YOU?</span><input name="name" autocomplete="name" placeholder="Enter your name" required></label>
        <label><b>02</b><span>WHEN DID YOUR JOURNEY BEGIN?</span><input name="birth_date" type="date" required></label>
        <label><b>03</b><span>AT WHAT TIME?</span><input name="birth_time" type="time" required></label>
        <label><b>04</b><span>WHERE WERE THE STARS ALIGNED?</span><input name="birth_place" autocomplete="address-level2" placeholder="Enter your birth place" required></label>
        <fieldset><legend><b>05</b> WHAT ARE YOU SEEKING CLARITY ON?</legend>
          <div class="qi-sacred__intentions">
            <label><input type="radio" name="intention" value="Emotional Balance" required><span><i>☾</i>Emotional<br>Balance</span></label>
            <label><input type="radio" name="intention" value="Purpose & Growth"><span><i>✦</i>Purpose &<br>Growth</span></label>
            <label><input type="radio" name="intention" value="Love & Connection"><span><i>♡</i>Love &<br>Connection</span></label>
          </div>
        </fieldset>
        <button class="qi-sacred__submit" type="submit">{{ section.settings.submit_text }} <span>＋</span></button>
        <p class="qi-sacred__privacy">♙ Your information is sacred and protected.<br>We respect your privacy.</p>
        <p class="qi-sacred__status" role="status" aria-live="polite" data-form-status></p>
      </form>
    </div>
  </div>

  <div class="qi-sacred__journey page-width">
    <p>ANCIENT WISDOM. PERSONALIZED FOR YOU.</p><h2>A Journey Into Your True Essence</h2>
    <div class="qi-sacred__pillars">
      <article><i>☉</i><h3>PERSONAL REFLECTION</h3><p>AI-powered interpretation of your birth details and chosen intention.</p></article>
      <article><i>◉</i><h3>ENERGY INSIGHTS</h3><p>Understand your strengths, tensions and hidden gifts.</p></article>
      <article><i>♢</i><h3>CRYSTAL ALIGNMENT</h3><p>Discover the symbolic crystal that resonates with your journey.</p></article>
      <article><i>◯</i><h3>PERSONAL BRACELET</h3><p>Continue your reflection with a bracelet selected for your path.</p></article>
    </div>
  </div>

  <dialog class="qi-sacred__ritual" data-ritual-dialog>
    <button class="qi-sacred__ritual-close" type="button" aria-label="Close" data-close-ritual>×</button>
    <div class="qi-sacred__ritual-wheel" aria-hidden="true">✦</div>
    <p data-ritual-stage>ALIGNING YOUR CELESTIAL PATTERNS…</p>
  </dialog>
</section>

{% schema %}
{
  "name": "QI Sacred Astrology Hero",
  "tag": "section",
  "class": "section-qi-sacred-hero",
  "settings": [
    {"type":"image_picker","id":"priestess","label":"Priestess image"},
    {"type":"link_list","id":"menu","label":"Navigation menu"},
    {"type":"text","id":"api_endpoint","label":"Secure AI API endpoint","info":"Optional. Example: https://api.yourdomain.com/astral-reading"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"A PERSONAL ASTROLOGICAL JOURNEY"},
    {"type":"inline_richtext","id":"heading","label":"Heading","default":"Reveal The Story Written In Your Stars"},
    {"type":"richtext","id":"text","label":"Introduction","default":"<p>Your birth chart holds the keys to your personality, purpose and inner energy. Discover your personalized crystal connection and guidance.</p>"},
    {"type":"text","id":"cta","label":"Primary button","default":"BEGIN YOUR READING"},
    {"type":"text","id":"form_heading","label":"Form heading","default":"YOUR ASTRAL PROFILE"},
    {"type":"textarea","id":"form_text","label":"Form introduction","default":"Share your birth details to reveal your energy map."},
    {"type":"text","id":"submit_text","label":"Submit button","default":"REVEAL MY ENERGY MAP"}
  ],
  "presets": [{"name":"QI Sacred Astrology Hero"}]
}
{% endschema %}
